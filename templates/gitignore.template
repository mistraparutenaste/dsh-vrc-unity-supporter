# DSH working files (logs, task results and the GUID index stay local)
/.dsh/
/Assets/DSH/Results/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated files
/[Aa]ssets/AssetStoreTools*
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# VPM lockfile is committed on purpose: it pins package versions
!/[Pp]ackages/vpm-lock.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Large binaries (add to Git LFS instead of ignoring when needed)
*.zip
*.7z
